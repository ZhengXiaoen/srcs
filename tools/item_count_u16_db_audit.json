  "procedures": [
    {
      "name": "loadcharitems",
      "carrier": "D:\\SRCS\\phpStudy\\PHPTutorial\\MySQL\\data\\mysql\\proc.MYD",
      "carrier_sha256": "96eb3b4458c5b00f81c2295f08168fffa523cedd01fbd13731c8c411f73519cf",
      "body_offset": 69892,
      "body_length": 2559,
      "body_sha256": "12493e0497d48d73a77550f02b0fe9f745ca84416aa9feb1c9523d6925713c25",
      "body": "begin\r\n     declare boexists integer default null;\r\n    \r\n \r\n     if nitemtableid =1 then\r\n         select itemguid,itemidquastrong,itemduration,itemcountflag,iteminlayhole,itemtime,itemreservs,itemsmith1,itemsmith2,itemsmith3,itemreservs2,initsmith,strongdata,circleforge,typevalue,appraisal,thebestlevel,scenetag,actorname,taostrong,realinjury,runedebris from actorbagitem  where `actorid` = nactorid;\r\n     end if;\r\n     if nitemtableid =2 then\r\n         select itemguid,itemidquastrong,itemduration,itemcountflag,iteminlayhole,itemtime,itemreservs,itemsmith1,itemsmith2,itemsmith3,itemreservs2,initsmith,strongdata,circleforge,typevalue,appraisal,thebestlevel,scenetag,actorname,taostrong,realinjury,runedebris from actorequipitem  where `actorid` = nactorid;\r\n     end if;\r\n     if nitemtableid =3 then\r\n          select itemguid,itemidquastrong,itemduration,itemcountflag,iteminlayhole,itemtime,itemreservs,itemsmith1,itemsmith2,itemsmith3,itemreservs2,initsmith,strongdata,circleforge,typevalue,appraisal,thebestlevel,scenetag,actorname,taostrong,realinjury,runedebris  from actordepotitem  where `actorid` = nactorid;\r\n     end if;\r\n     if nitemtableid =4 then\r\n          select itemguid,itemidquastrong,itemduration,itemcountflag,iteminlayhole,itemtime,itemreservs,itemsmith1,itemsmith2,itemsmith3,itemreservs2,initsmith,strongdata,circleforge,typevalue,appraisal,thebestlevel,scenetag,actorname,taostrong,realinjury,runedebris  from actorconsignment;\r\n     end if;\r\n     if nitemtableid =5 then\r\n          select itemguid,itemidquastrong,itemduration,itemcountflag,iteminlayhole,itemtime,itemreservs,itemsmith1,itemsmith2,itemsmith3,itemreservs2,initsmith,strongdata,circleforge,typevalue,appraisal,thebestlevel,scenetag,actorname,taostrong,realinjury,runedebris  from actorpetitem where `actorid` = nactorid;\r\n     end if;\r\n     if nitemtableid =6 then\r\n          select itemguid,itemidquastrong,itemduration,itemcountflag,iteminlayhole,itemtime,itemreservs,itemsmith1,itemsmith2,itemsmith3,itemreservs2,initsmith,strongdata,circleforge,typevalue,appraisal,thebestlevel,scenetag,actorname,taostrong,realinjury,runedebris  from actordmkjitem where `actorid` = nactorid;\r\n     end if;\r\n     if nitemtableid =8 then\r\n          select itemguid,itemidquastrong,itemduration,itemcountflag,iteminlayhole,itemtime,itemreservs,itemsmith1,itemsmith2,itemsmith3,itemreservs2,initsmith,strongdata,circleforge,typevalue,appraisal,thebestlevel,scenetag,actorname,taostrong,realinjury,runedebris from actormagicitem where `actorid` = nactorid;\r\n     end if;\r\nend"
    },
    {
      "name": "loadguildstoredata",
      "carrier": "D:\\SRCS\\phpStudy\\PHPTutorial\\MySQL\\data\\mysql\\proc.MYD",
      "carrier_sha256": "96eb3b4458c5b00f81c2295f08168fffa523cedd01fbd13731c8c411f73519cf",
      "body_offset": 90248,
      "body_length": 336,
      "body_sha256": "b5d70b7b85b80cc2f2f424bbfe3e54d617452827543b370337c1771859668a20",
      "body": "begin\r\n    select itemguid,itemidquastrong,itemduration,itemcountflag,iteminlayhole,itemtime,itemreservs,itemsmith1,itemsmith2,itemsmith3,itemreservs2,initsmith,actorid,ntype,nmoney,strongdata,circleforge,typevalue,appraisal,thebestlevel,scenetag,actorname,taostrong,realinjury,runedebris from guildstore  where guildid = nguildid;\r\nend"
    },
    {
      "name": "loadconsignmentext",
      "carrier": "D:\\SRCS\\phpStudy\\PHPTutorial\\MySQL\\data\\mysql\\proc.MYD",
      "carrier_sha256": "96eb3b4458c5b00f81c2295f08168fffa523cedd01fbd13731c8c411f73519cf",
      "body_offset": 78104,
      "body_length": 1062,
      "body_sha256": "3c6bf59e2ca01a8e20b94e567b276c853c33908c47e4253753034a0b12ed297d",
      "body": "begin\r\n    if nactorid = 0 then\r\n    select itemguid,itemidquastrong,itemduration,itemcountflag,iteminlayhole,itemtime,itemreservs,itemsmith1,itemsmith2,itemsmith3,itemreservs2,initsmith,resttime,price,actorconsignment.actorid,actors.actorname,typestatus,strongdata,circleforge,typevalue,appraisal,thebestlevel,scenetag,actorconsignment.actorname,taostrong,realinjury,runedebris\r\n      from actorconsignment,actors where (typestatus & 1) = 0 and actorconsignment.actorid=actors.actorid and actorconsignment.serverindex=nserverindex;\r\n     else\r\n     select itemguid,itemidquastrong,itemduration,itemcountflag,iteminlayhole,itemtime,itemreservs,itemsmith1,itemsmith2,itemsmith3,itemreservs2,initsmith,resttime,price,actorconsignment.actorid,actors.actorname,typestatus,strongdata,circleforge,typevalue,appraisal,thebestlevel,scenetag,actorconsignment.actorname,taostrong,realinjury,runedebris\r\n      from actorconsignment,actors where actorconsignment.actorid =nactorid and actorconsignment.actorid=actors.actorid and (typestatus & 1) = 1;\r\n    end if;\r\n    \r\nend"
    }
  ],
